# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtualenv / uv
.venv/
venv/
env/

# Build artifacts
dist/
build/
*.whl

# Test / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment
.env
.env.*
!.env.example
.envrc.private

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Orphan-branch worktrees (managed separately)
vault/
.beads/

# Feature worktrees (per .claude/rules edit-routing convention)
/.worktrees/

# Node (commitlint devDependencies)
node_modules/

# Beads / Dolt files (added by bd init; kept here even though .beads/ is a
# worktree mount — these patterns guard against accidental commits if the
# worktree is ever replaced by a regular directory)
.dolt/
*.db
.beads-credential-key

# Private founding / business artifacts (per workspace-visibility.md)
internal/
