# Environment overrides for the local dev stack (docker-compose.yml).
# `just up` copies this file to .env on first run; password variables have
# no inline compose defaults, so .env must exist. These placeholder values
# are for LOCALHOST DEVELOPMENT ONLY — set real values via your secret manager for anything
# beyond a local laptop stack.

# PostgreSQL (host port 5437)
HDP_POSTGRES_USER=hdp
HDP_POSTGRES_PASSWORD=changeme
HDP_POSTGRES_DB=hdp

# MongoDB (host port 27037)
HDP_MONGO_USER=hdp
HDP_MONGO_PASSWORD=changeme
