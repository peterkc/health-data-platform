# HDP workspace environment
export HDP_HOME="${PWD}"

# Bootstrap git hooks via lefthook (idempotent). `lefthook install` writes
# `.git/hooks/*` so git ops fire the configured commands (beads + fmt/lint).
# bd init sets core.hooksPath=.beads/hooks, which BYPASSES lefthook — unset it
# so the .git/hooks/ stubs take effect.
if command -v lefthook >/dev/null 2>&1 && [[ -f "${HDP_HOME}/lefthook.yml" ]]; then
  git config --local --unset-all core.hooksPath 2>/dev/null || true
  (cd "${HDP_HOME}" && lefthook install >/dev/null 2>&1) || true
fi

# -----------------------------------------------------------------------------
# region :: claude (agx hooks read CLAUDE_PROJECT_DIR; worktree-safe root)
# -----------------------------------------------------------------------------
export CLAUDE_PROJECT_DIR=${HDP_HOME:-$PWD}
export ENABLE_BACKGROUND_TASKS=1
export FORCE_AUTO_BACKGROUND_TASKS=1
# endregion

# -----------------------------------------------------------------------------
# region :: git
# -----------------------------------------------------------------------------
export GIT_PAGER=${GIT_PAGER:-""}
# endregion

# -----------------------------------------------------------------------------
# Load private overrides BEFORE Doppler (allows DOPPLER_PROJECT/CONFIG override)
# -----------------------------------------------------------------------------
source_env_if_exists .envrc.private

# -----------------------------------------------------------------------------
# region :: Doppler (secrets management) - MUST BE LAST before telemetry
# -----------------------------------------------------------------------------
# Loads secrets if Doppler is installed and authenticated.
# Contributors without Doppler: this block silently skips.
export DOPPLER_PROJECT="${DOPPLER_PROJECT:-dfx}"
export DOPPLER_CONFIG="${DOPPLER_CONFIG:-dev}"

if command -v doppler &> /dev/null && doppler whoami &> /dev/null 2>&1; then
  set -a
  source <(doppler secrets download --no-file --format env --project "$DOPPLER_PROJECT" --config "$DOPPLER_CONFIG" 2>/dev/null) || true
  set +a
fi
# endregion
